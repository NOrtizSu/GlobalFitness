<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup (API 30 and lower): a safety net that works without signing in.
    Everything is backed up (app databases and normal preferences) except:
    - band_prefs and wearable_prefs: the paired bands and watches (Bluetooth addresses), their
      settings and the names of the apps that posted notifications. They belong to this phone's
      pairings; the auth keys themselves live in noBackupFilesDir and are never backed up.
    - band.db: live heart rate recorded in direct mode, with the devices' Bluetooth addresses.
    - onboarding: decided again on the new device from the restored profile.
    - workout_notification: whether Android's notification permission was asked; the new device asks
      again when a workout starts.
    - health.db: Health Connect cache, re-read from Health Connect on the new device.
    - Firestore's local cache: it belongs to the signed-in session and would replay stale writes.
    - exercise_photos: photos of the user's machines. They could exceed the 25 MB Auto Backup quota
      (which would stop backing up the measurements too); the app's cloud backup keeps them, and
      training.db (with the notes) is still backed up.
    Cloud sync bookkeeping lives in noBackupFilesDir, which is never backed up.
    Keep in sync with data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="band_prefs.xml" />
    <exclude domain="sharedpref" path="wearable_prefs.xml" />
    <exclude domain="sharedpref" path="onboarding.xml" />
    <exclude domain="sharedpref" path="workout_notification.xml" />
    <exclude domain="database" path="band.db" />
    <exclude domain="database" path="band.db-journal" />
    <exclude domain="database" path="band.db-wal" />
    <exclude domain="database" path="band.db-shm" />
    <exclude domain="database" path="health.db" />
    <exclude domain="database" path="health.db-journal" />
    <exclude domain="database" path="health.db-wal" />
    <exclude domain="database" path="health.db-shm" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-journal" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-wal" />
    <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-shm" />
    <exclude domain="file" path="exercise_photos/" />
</full-backup-content>

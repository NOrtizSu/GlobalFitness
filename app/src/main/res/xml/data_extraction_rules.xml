<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup / device-to-device transfer (API 31+). Same policy as backup_rules.xml:
    back up the app databases and normal preferences, but never the bands and watches set up on this
    phone (band_prefs, wearable_prefs: Bluetooth addresses, settings, names of notifying apps; their
    auth keys live in noBackupFilesDir), their recorded live heart rate (band.db), the onboarding
    flag, whether the notification permission was asked (workout_notification), the Health Connect
    cache (health.db) or Firestore's local cache. Machine photos
    (files/exercise_photos) are left out of the Drive backup only (25 MB quota; the app's cloud backup
    keeps them) and are copied in a device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="band_prefs.xml" />
        <exclude domain="sharedpref" path="wearable_prefs.xml" />
        <exclude domain="sharedpref" path="onboarding.xml" />
        <exclude domain="sharedpref" path="workout_notification.xml" />
        <exclude domain="database" path="band.db" />
        <exclude domain="database" path="band.db-journal" />
        <exclude domain="database" path="band.db-wal" />
        <exclude domain="database" path="band.db-shm" />
        <exclude domain="database" path="health.db" />
        <exclude domain="database" path="health.db-journal" />
        <exclude domain="database" path="health.db-wal" />
        <exclude domain="database" path="health.db-shm" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-journal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-wal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-shm" />
        <exclude domain="file" path="exercise_photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="band_prefs.xml" />
        <exclude domain="sharedpref" path="wearable_prefs.xml" />
        <exclude domain="sharedpref" path="onboarding.xml" />
        <exclude domain="sharedpref" path="workout_notification.xml" />
        <exclude domain="database" path="band.db" />
        <exclude domain="database" path="band.db-journal" />
        <exclude domain="database" path="band.db-wal" />
        <exclude domain="database" path="band.db-shm" />
        <exclude domain="database" path="health.db" />
        <exclude domain="database" path="health.db-journal" />
        <exclude domain="database" path="health.db-wal" />
        <exclude domain="database" path="health.db-shm" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-journal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-wal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.globalfitness-app.%28default%29-shm" />
    </device-transfer>
</data-extraction-rules>
